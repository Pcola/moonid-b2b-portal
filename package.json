{
  "name": "moonid-b2b-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "load": "k6 run tests/load/read-path.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "import:catalog": "tsx scripts/pohoda/import-catalog.ts",
    "import:sources": "tsx scripts/pohoda/import-sources.ts",
    "match:sources": "tsx scripts/pohoda/match-sources.ts",
    "export:candidates": "tsx scripts/pohoda/export-candidates.ts",
    "apply:verdicts": "tsx scripts/pohoda/apply-verdicts.ts",
    "export:broad": "tsx scripts/pohoda/export-broad-candidates.ts",
    "apply:broad": "tsx scripts/pohoda/apply-broad.ts",
    "publish:curated": "tsx scripts/pohoda/publish-curated.ts",
    "backfill:slugs": "tsx scripts/pohoda/backfill-slugs.ts",
    "premap:links": "tsx scripts/pohoda/premap-links.ts",
    "import:feed": "tsx scripts/pohoda/import-feed-products.ts",
    "price:feed": "tsx scripts/pohoda/price-feed-products.ts",
    "group:variants": "tsx scripts/pohoda/group-variants.ts",
    "pohoda:rpc": "prisma db execute --file database/pohoda-agent.sql --schema prisma/schema.prisma",
    "audit:lock": "prisma db execute --file database/audit-append-only.sql --schema prisma/schema.prisma",
    "seed:auth": "tsx scripts/auth/seed-auth.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "@sentry/nextjs": "^10.61.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "prisma": "^6.8.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
