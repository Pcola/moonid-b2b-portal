# Testovacie premenné pre Playwright E2E (skopíruj do .env.test a doplň heslá).
# .env.test je gitignored — heslá NIKDY necommituj.
E2E_BASE_URL=https://moonid-b2b-portal.vercel.app

# Dealer (zákaznícky) testovací účet
E2E_DEALER_EMAIL=zakaznik@moonid.test
E2E_DEALER_PASSWORD=

# Staff testovací účet
E2E_STAFF_EMAIL=staff@moonid.test
E2E_STAFF_PASSWORD=

# Odomkne deštruktívny test odoslania objednávky (default vypnuté)
# E2E_PLACE_ORDER=1
