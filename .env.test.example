# Testovacie premenné (skopíruj do .env.test a doplň hodnoty).
# .env.test je gitignored — heslá NIKDY necommituj.

# ─── Integračné testy (vitest) ──────────────────────────────────────────────
# POVINNÉ, ak nechceš, aby guard zastavil testy: samostatná DB pre testy.
# Testy robia deleteMany a spotrebúvajú čísla objednávok → NIKDY nie produkčná DB.
# Môže to byť samostatný Supabase projekt/branch alebo lokálny Postgres.
TEST_DATABASE_URL=
# TEST_DIRECT_URL=            # ak sa líši (priame spojenie pre migrácie)

# ─── E2E (Playwright) ───────────────────────────────────────────────────────
# Mier na PREVIEW deployment, nie na produkciu (E2E vie odoslať reálnu objednávku).
E2E_BASE_URL=

# Zákaznícky administrátor (CUSTOMER_ADMIN), lebo smoke overuje aj faktúry a používateľov.
# E2E_CUSTOMER_* a E2E_DEALER_* zostávajú spätne kompatibilné iba pre lokálne testy.
E2E_CUSTOMER_ADMIN_EMAIL=
E2E_CUSTOMER_ADMIN_PASSWORD=

# Staff testovací účet
E2E_STAFF_EMAIL=staff@moonid.test
E2E_STAFF_PASSWORD=
E2E_STAFF_TOTP_SECRET=

# Pre Vercel Authentication / bot protection na Preview deploymente.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Odomkne deštruktívny test odoslania objednávky (default vypnuté)
# E2E_PLACE_ORDER=1
# E2E_ALLOW_MUTATIONS_HOST=presny-staging-host.vercel.app
