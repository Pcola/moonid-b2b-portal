// ============================================================
//  Moonid B2B portál — KÁNONICKÝ dátový model
//  Pohoda = system of record; portál zrkadlí (cache) + rozširuje.
//  Vlastníctvo polí: [C]=cache z Pohody (píše len inbound sync),
//  [P]=vlastnené portálom, [H]=hybrid. Detaily: docs/BUILD_BLUEPRINT.md §2.
//  Peniaze Decimal(12,4), množstvá Decimal(12,3).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enumy ----------

enum Role {
  CUSTOMER_USER
  CUSTOMER_ADMIN
  STAFF
  ADMIN
}

enum ShelfStatus {
  FEATURED
  CATALOG
  ARCHIVED
}

enum CurationOverride {
  NONE
  FORCE_FEATURED
  FORCE_HIDE
}

enum ProductKind {
  CONSUMABLE
  DISPENSER
  EQUIPMENT
}

enum ContentStatus {
  STUB
  DRAFT
  READY
}

// ---- Enrichment zdroje katalógu (PIM) ----
enum SourceType {
  HUMED_FEED // XML feed partner.humed.sk
  MANUAL // ručne adminom (SUPPLIER / MANUFACTURER / HUMED_WEB pribudnú neskôr — additívne)
}

enum MatchStatus {
  SUGGESTED // auto-návrh zhody, čaká na admina
  CONFIRMED // potvrdené adminom → skopírované do Product
  REJECTED // odmietnuté (pretrvá — matcher nenavrhuje znova)
}

enum MatchMethod {
  CODE // g:sku == SKz.IDS (po normalizácii vedúcich núl)
  NAME // Jaccard skóre názvu
  MANUAL // admin priradil ručne
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PriceSource {
  POHODA
  COMPUTED
}

enum OrderStatus {
  PRIJATA
  POTVRDENA
  PRIPRAVUJE
  NA_CESTE
  DORUCENA
  STORNO
}

enum PohodaSyncStatus {
  LOKALNA
  CAKA_NA_OBJ
  OBJ_VYTVORENA
  CAKA_NA_FA
  FA_VYTVORENA
  CHYBA
}

enum Fulfillment {
  SKLADOM
  NA_OBJEDNAVKU
}

enum StatusSource {
  PORTAL
  POHODA_SYNC
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum Arrangement {
  RENTAL
  PLACED_FREE
  SOLD
}

enum RefillSource {
  DERIVED
  MANUAL
  CONFIRMED
}

enum SyncJobKind {
  CREATE_OBJ
  PULL_FA
  CANCEL_OBJ
}

enum SyncJobStatus {
  QUEUED
  CLAIMED
  PUSHED
  FAILED
}

// ---------- Cenové úrovne ----------

model PriceTier {
  id            String    @id @default(cuid())
  code          String    @unique // "A","B1","B2","B3"
  name          String
  discountPct   Decimal   @db.Decimal(5, 2) // FALLBACK kým hladiny nie sú v Pohode
  pohodaCenyIds String?
  companies     Company[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Firma (zákazník) ---------- [C] join cez ICO

model Company {
  id            String             @id @default(cuid())
  ico           String             @unique
  dic           String?
  icDph         String?
  name          String
  city          String?
  address       String?
  priceTier     PriceTier          @relation(fields: [priceTierId], references: [id])
  priceTierId   String
  splatDays     Int                @default(14)
  pohodaCenyIds String?
  pohodaRefAd   Int?
  active        Boolean            @default(true)
  syncedAt      DateTime?
  users         User[]
  locations     DeliveryLocation[]
  carts         Cart[]
  orders        Order[]
  invoices      Invoice[]
  dispensers    CompanyDispenser[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([priceTierId])
}

model DeliveryLocation {
  id         String             @id @default(cuid())
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  label      String
  street     String?
  city       String?
  zip        String?
  isDefault  Boolean            @default(false)
  orders     Order[]
  dispensers CompanyDispenser[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([companyId])
}

// ---------- Používateľ ---------- [P] identita cez Supabase Auth

model User {
  id            String             @id @default(cuid())
  authId        String             @unique
  email         String             @unique
  name          String?
  role          Role               @default(CUSTOMER_USER)
  company       Company?           @relation(fields: [companyId], references: [id])
  companyId     String?
  mfaEnabled    Boolean            @default(false)
  active        Boolean            @default(true)
  lastLoginAt   DateTime?
  ordersCreated Order[]            @relation("OrderCreatedBy")
  cartsCreated  Cart[]             @relation("CartCreatedBy")
  statusEvents  OrderStatusEvent[] @relation("StatusChangedBy")
  auditLogs     AuditLog[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([companyId])
  @@index([role])
}

// ---------- Žiadosti o prístup (onboarding) ---------- [P]

model AccessRequest {
  id           String        @id @default(cuid())
  ico          String
  companyName  String
  contactName  String
  email        String
  phone        String?
  note         String?
  status       RequestStatus @default(PENDING)
  resolvedById String? // User.id staffa, ktorý vybavil
  resolvedAt   DateTime?
  companyId    String? // priradená firma po schválení
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

// ---------- Katalóg ----------

model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  sortOrder       Int       @default(0)
  icon            String?
  pohodaGroupCode String?
  products        Product[]
}

model Product {
  id                 String           @id @default(cuid())
  sku                String           @unique // = SKz.IDS (Pohoda-origin) / g:sku (feed-origin, kým sa nenamapuje)
  origin             ProductOrigin    @default(POHODA) // POHODA = auto-most; FEED = treba namapovať
  name               String // [C] názov z Pohody
  nameDisplay        String? // [P] kuratovaný názov pre web
  category           Category?        @relation(fields: [categoryId], references: [id])
  categoryId         String?
  brand              String?
  systemCode         String? // Tork N4/H2/S4/T3...
  subcategory        String? // [P] 2. úroveň kategórie (z feed kategoriaPlna) — kaskádový facet
  scent              String? // [P] vôňa — facet
  color              String? // [P] farba — facet
  material           String? // [P] materiál — facet
  packSize           String? // [P] veľkosť balenia — facet
  unit               String           @default("ks") // [C] SKz.MJ
  mj2Koef            Decimal?         @db.Decimal(12, 3)
  vatRate            Decimal          @default(23) @db.Decimal(5, 2)
  basePrice          Decimal?         @db.Decimal(12, 4) // [C] ProdejKc
  costPrice          Decimal?         @db.Decimal(12, 4) // [C] VNakup — NIKDY zákazníkovi
  stockCache         Decimal?         @db.Decimal(12, 3) // [C] StavZ
  reserved           Decimal?         @db.Decimal(12, 3)
  stockSyncedAt      DateTime?
  isStocked          Boolean          @default(false) // drží sa skladom vs back-order
  leadDays           Int              @default(5)
  productKind        ProductKind      @default(CONSUMABLE)
  isSubsidized       Boolean          @default(false) // dotovaný/prenajatý dávkovač → cena na vyžiadanie
  shelfStatus        ShelfStatus      @default(CATALOG)
  featuredReason     String?
  curationOverride   CurationOverride @default(NONE)
  contentStatus      ContentStatus    @default(STUB)
  // ---- PIM / info vrstva [P] — píše admin/enrichment, NIE Pohoda inbound sync ----
  slug               String?          @unique // verejná URL; stabilná po prvom vygenerovaní
  ean                String? // efektívny EAN (z dôveryhodného zdroja/ručne; NIE z feed g:gtin)
  descriptionShort   String?
  descriptionLong    String?          @db.Text
  attributes         Json? // [P] voľné atribúty pre filtre (objem, paleta, hmotnosť, Tork detail…)
  isPublished        Boolean          @default(false) // verejný web zobrazuje len isPublished=true
  lastSeenInPohodaAt DateTime? // [C] pre reconcile/tombstone — čo zmizne z exportu sa archivuje
  // ---- varianty [P] (Fáza B) ----
  variantGroup       ProductGroup?    @relation(fields: [variantGroupId], references: [id])
  variantGroupId     String? // null = samostatný produkt
  variantAxis        String? // scent | color | size | pack
  variantLabel       String? // hodnota pre prepínač ("Citrón", "1000 ml")
  variantSort        Int?
  isDefaultVariant   Boolean          @default(false) // reprezentant skupiny v katalógu
  prices             ProductPrice[]
  media              ProductMedia[]
  sources            ProductSource[]
  pohodaLink         ProductLink? // most na Pohoda kartu (1:1; null = nenamapované)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  syncedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([categoryId])
  @@index([shelfStatus])
  @@index([productKind])
  @@index([isPublished])
  @@index([origin])
  @@index([brand])
  @@index([systemCode])
  @@index([subcategory])
  @@index([scent])
  @@index([color])
  @@index([packSize])
  @@index([attributes], type: Gin)
  @@index([variantGroupId])
}

// ---------- Variantná skupina [P] (Fáza B) — tenký parent: zobrazenie + výber variantu; ŽIADNA cena/sklad/most ----------
model ProductGroup {
  id              String    @id @default(cuid())
  name            String
  slug            String?   @unique
  categoryId      String? // denormalizované pre filter (bez FK)
  primaryAxis     String? // hlavná os variantu (scent | color | size | pack)
  descriptionLong String?   @db.Text
  isPublished     Boolean   @default(false) // agregát: zobrazí sa ak má aspoň 1 publikovaný variant
  members         Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId])
}

// ---------- Most katalóg → Pohoda karta [P] (lazy mapping; rieši IDENTITU, nie cenu) ----------
model ProductLink {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String     @unique
  pohodaSku    String // = SKz.IDS (kód karty v Pohode); TEXT, nie FK (Pohoda nie je v Postgrese)
  pohodaCardId Int? // SKz.ID (interné ID karty) ak ho inbound pozná
  linkMethod   LinkMethod
  linkStatus   LinkStatus @default(ACTIVE)
  confidence   Decimal?   @db.Decimal(5, 4)
  sourceId     String? // ProductSource.id ktorý dal návrh (audit, NIE FK)
  matchedBy    String // kto/čo most vytvoril (email / "premap" / "ai")
  matchedAt    DateTime   @default(now())
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([pohodaSku]) // NIE unique — Pohoda má jednu kartu pre viac balení/variantov
  @@index([linkStatus])
  @@index([pohodaCardId])
}

enum ProductOrigin {
  POHODA
  FEED
  MANUAL
}

enum LinkMethod {
  PREMAPPED // dávkové predmapovanie (sku=IDS / Pohoda história)
  SUGGESTED_CONFIRMED // staff potvrdil návrh
  MANUAL // staff zadal kód ručne
  NEW_CARD_REQUESTED // treba založiť novú Pohoda kartu
}

enum LinkStatus {
  ACTIVE // most platí
  PENDING_CARD // čaká na založenie karty (až s inbound agentom)
  BROKEN // kód zmizol z Pohody (až s inbound reconcile)
}

model ProductPrice {
  id            String      @id @default(cuid())
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  priceTierCode String
  unitPriceNet  Decimal     @db.Decimal(12, 4)
  source        PriceSource @default(POHODA)
  syncedAt      DateTime?

  @@unique([productId, priceTierCode])
  @@index([priceTierCode])
}

model ProductMedia {
  id          String  @id @default(cuid())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  storagePath String // Supabase Storage (alebo dočasne CDN URL z enrichmentu)
  alt         String?
  isPrimary   Boolean @default(false)
  sortOrder   Int     @default(0)

  @@index([productId])
}

// ---------- Enrichment kandidáti (PIM) ---------- [P]
// 1 Product : N surových zdrojov (humed feed, neskôr ďalší). Obsah sa do Product
// kopíruje až pri CONFIRM (jednorazovo) — re-import feedu Product neprepisuje.
// purchasePrice / raw sú INTERNÉ a nikdy sa neserializujú klientovi.
model ProductSource {
  id              String       @id @default(cuid())
  product         Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String? // NULL = nespárovaný kandidát; po rozhodnutí (CONFIRM/REJECT) je vyplnené
  sourceType      SourceType
  externalId      String? // g:id (HUMED_FEED — vždy prítomné, idempotentný kľúč)
  externalSku     String? // g:sku
  title           String?
  imageUrl        String? // g:image_link (CDN)
  ean             String? // len z dôveryhodného zdroja; pre HUMED_FEED zostáva NULL (g:gtin je falošný)
  descriptionLong String?      @db.Text
  brand           String?
  purchasePrice   Decimal?     @db.Decimal(12, 4) // g:cenaVhumede — INTERNÉ, nikdy von
  sourceUrl       String?
  raw             Json? // sanitizovaný surový item (bez cenových uzlov) na audit/re-parse
  matchStatus     MatchStatus  @default(SUGGESTED)
  matchScore      Float? // 0..1 (NAME); CODE = 1.0
  matchMethod     MatchMethod?
  matchedBy       String? // User.id kto rozhodol
  matchedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([sourceType, externalId]) // idempotentný upsert feedu
  @@index([productId])
  @@index([matchStatus])
  @@index([externalSku])
}

// ---------- Košík ---------- [P]

model Cart {
  id                 String     @id @default(cuid())
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  createdBy          User       @relation("CartCreatedBy", fields: [createdById], references: [id])
  createdById        String
  deliveryLocationId String?
  items              CartItem[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([companyId])
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  qty       Decimal @db.Decimal(12, 3)

  @@unique([cartId, productId])
}

// ---------- Objednávky ---------- [H]

model Order {
  id                    String             @id @default(cuid())
  number                String             @unique // "WEB-2026-00042"
  company               Company            @relation(fields: [companyId], references: [id])
  companyId             String
  createdBy             User               @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById           String
  deliveryLocation      DeliveryLocation?  @relation(fields: [deliveryLocationId], references: [id])
  deliveryLocationId    String?
  status                OrderStatus        @default(PRIJATA)
  hasBackorder          Boolean            @default(false)
  priceTierCode         String
  note                  String?
  subtotal              Decimal            @default(0) @db.Decimal(12, 4)
  vat                   Decimal            @default(0) @db.Decimal(12, 4)
  total                 Decimal            @default(0) @db.Decimal(12, 4)
  requestedDeliveryDate DateTime?
  promisedDeliveryDate  DateTime?
  confirmedAt           DateTime?
  // technická os synca s Pohodou (zákazník nevidí)
  pohodaSync            PohodaSyncStatus   @default(LOKALNA)
  pohodaObjNumber       String?
  pohodaFaNumber        String?
  pohodaPushedAt        DateTime?
  pohodaCancelRequested Boolean            @default(false) // storno vyžiadané kým OBJ in-flight → kompenzačné CANCEL
  items                 OrderItem[]
  events                OrderStatusEvent[]
  invoice               Invoice?
  syncJobs              PohodaSyncJob[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([pohodaSync])
}

model OrderItem {
  id                String      @id @default(cuid())
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  product           Product     @relation(fields: [productId], references: [id])
  productId         String
  skuSnapshot       String
  pohodaSkuSnapshot String? // [most] Pohoda kód zamknutý pri POTVRDENÍ; null = ešte nešlo do Pohody
  nameSnapshot      String
  unitPriceSnapshot Decimal     @db.Decimal(12, 4)
  costSnapshot      Decimal?    @db.Decimal(12, 4)
  qty               Decimal     @db.Decimal(12, 3)
  lineTotal         Decimal     @db.Decimal(12, 4)
  fulfillment       Fulfillment @default(SKLADOM)
  expectedAt        DateTime?

  @@index([orderId])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  status      OrderStatus
  changedBy   User?        @relation("StatusChangedBy", fields: [changedById], references: [id])
  changedById String?
  source      StatusSource @default(PORTAL)
  note        String?
  occurredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

// Atomické číslovanie objednávok (per rok) — race-safe cez increment v $transaction.
model OrderCounter {
  year    Int @id
  lastSeq Int @default(0)
}

// ---------- Faktúry ---------- [C] cache z Pohody + PDF

model Invoice {
  id             String        @id @default(cuid())
  pohodaNumber   String        @unique
  company        Company       @relation(fields: [companyId], references: [id])
  companyId      String
  order          Order?        @relation(fields: [orderId], references: [id])
  orderId        String?       @unique
  status         InvoiceStatus @default(PENDING)
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  subtotal       Decimal       @db.Decimal(12, 4)
  vat            Decimal       @db.Decimal(12, 4)
  total          Decimal       @db.Decimal(12, 4)
  pdfStoragePath String?
  sourceDbYear   Int?
  syncedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([status])
}

// ---------- Dávkovače / installed base ---------- [P]

model DispenserModel {
  id           String             @id @default(cuid())
  dispenserSku String             @unique
  name         String
  imageUrl     String?
  systemCode   String?
  refills      DispenserRefill[]
  placements   CompanyDispenser[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model DispenserRefill {
  id               String         @id @default(cuid())
  dispenserModel   DispenserModel @relation(fields: [dispenserModelId], references: [id], onDelete: Cascade)
  dispenserModelId String
  refillSku        String
  rank             Int            @default(0) // 0 = primárna náplň
  source           RefillSource   @default(DERIVED)
  confidence       Decimal?       @db.Decimal(5, 4)

  @@unique([dispenserModelId, refillSku])
}

model CompanyDispenser {
  id                 String            @id @default(cuid())
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  dispenserModel     DispenserModel    @relation(fields: [dispenserModelId], references: [id])
  dispenserModelId   String
  deliveryLocation   DeliveryLocation? @relation(fields: [deliveryLocationId], references: [id])
  deliveryLocationId String?
  location           String?
  qty                Int               @default(1)
  arrangement        Arrangement       @default(RENTAL)
  placedAt           DateTime?
  avgRefillDays      Int?
  lastRefillAt       DateTime?
  nextRefillDue      DateTime?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([companyId])
}

// ---------- Sync infraštruktúra ---------- [P]

model SyncCursor {
  id        String    @id @default("singleton")
  skz       DateTime?
  ad        DateTime?
  prices    DateTime?
  fa        DateTime?
  updatedAt DateTime  @updatedAt
}

model SyncState {
  id              String    @id @default("singleton")
  lastInboundAt   DateTime?
  lastStockSyncAt DateTime?
  lastHeartbeatAt DateTime?
  agentVersion    String?
  updatedAt       DateTime  @updatedAt
}

model PohodaSyncJob {
  id        String        @id @default(cuid())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  kind      SyncJobKind
  payload   Json?
  status        SyncJobStatus @default(QUEUED)
  attempts      Int           @default(0)
  nextAttemptAt DateTime? // backoff: job sa nclaimuje až po tomto čase
  claimedBy     String?
  claimedAt     DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([status, nextAttemptAt])
}

model DocDedup {
  id        String   @id @default(cuid())
  docType   String
  docNumber String
  docDate   DateTime
  createdAt DateTime @default(now())

  @@unique([docType, docNumber, docDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
