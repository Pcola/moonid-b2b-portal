// ============================================================
//  Moonid B2B portál — KÁNONICKÝ dátový model
//  Pohoda = system of record; portál zrkadlí (cache) + rozširuje.
//  Vlastníctvo polí: [C]=cache z Pohody (píše len inbound sync),
//  [P]=vlastnené portálom, [H]=hybrid. Detaily: docs/BUILD_BLUEPRINT.md §2.
//  Peniaze Decimal(12,4), množstvá Decimal(12,3).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enumy ----------

enum Role {
  CUSTOMER_USER
  CUSTOMER_ADMIN
  STAFF
  ADMIN
}

enum ShelfStatus {
  FEATURED
  CATALOG
  ARCHIVED
}

enum CurationOverride {
  NONE
  FORCE_FEATURED
  FORCE_HIDE
}

enum ProductKind {
  CONSUMABLE
  DISPENSER
  EQUIPMENT
}

enum ContentStatus {
  STUB
  DRAFT
  READY
}

enum PriceSource {
  POHODA
  COMPUTED
}

enum OrderStatus {
  PRIJATA
  POTVRDENA
  PRIPRAVUJE
  NA_CESTE
  DORUCENA
  STORNO
}

enum PohodaSyncStatus {
  LOKALNA
  CAKA_NA_OBJ
  OBJ_VYTVORENA
  CAKA_NA_FA
  FA_VYTVORENA
  CHYBA
}

enum Fulfillment {
  SKLADOM
  NA_OBJEDNAVKU
}

enum StatusSource {
  PORTAL
  POHODA_SYNC
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum Arrangement {
  RENTAL
  PLACED_FREE
  SOLD
}

enum RefillSource {
  DERIVED
  MANUAL
  CONFIRMED
}

enum SyncJobKind {
  CREATE_OBJ
  PULL_FA
  CANCEL_OBJ
}

enum SyncJobStatus {
  QUEUED
  CLAIMED
  PUSHED
  FAILED
}

// ---------- Cenové úrovne ----------

model PriceTier {
  id            String    @id @default(cuid())
  code          String    @unique // "A","B1","B2","B3"
  name          String
  discountPct   Decimal   @db.Decimal(5, 2) // FALLBACK kým hladiny nie sú v Pohode
  pohodaCenyIds String?
  companies     Company[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Firma (zákazník) ---------- [C] join cez ICO

model Company {
  id            String   @id @default(cuid())
  ico           String   @unique
  dic           String?
  icDph         String?
  name          String
  city          String?
  address       String?
  priceTier     PriceTier @relation(fields: [priceTierId], references: [id])
  priceTierId   String
  splatDays     Int      @default(14)
  pohodaCenyIds String?
  pohodaRefAd   Int?
  active        Boolean  @default(true)
  syncedAt      DateTime?
  users         User[]
  locations     DeliveryLocation[]
  carts         Cart[]
  orders        Order[]
  invoices      Invoice[]
  dispensers    CompanyDispenser[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([priceTierId])
}

model DeliveryLocation {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  label      String
  street     String?
  city       String?
  zip        String?
  isDefault  Boolean  @default(false)
  orders     Order[]
  dispensers CompanyDispenser[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

// ---------- Používateľ ---------- [P] identita cez Supabase Auth

model User {
  id          String   @id @default(cuid())
  authId      String   @unique
  email       String   @unique
  name        String?
  role        Role     @default(CUSTOMER_USER)
  company     Company? @relation(fields: [companyId], references: [id])
  companyId   String?
  mfaEnabled  Boolean  @default(false)
  active      Boolean  @default(true)
  lastLoginAt DateTime?
  ordersCreated Order[]            @relation("OrderCreatedBy")
  cartsCreated  Cart[]             @relation("CartCreatedBy")
  statusEvents  OrderStatusEvent[] @relation("StatusChangedBy")
  auditLogs     AuditLog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([role])
}

// ---------- Katalóg ----------

model Category {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  sortOrder      Int       @default(0)
  icon           String?
  pohodaGroupCode String?
  products       Product[]
}

model Product {
  id               String        @id @default(cuid())
  sku              String        @unique // = SKz.IDS
  name             String        // [C] názov z Pohody
  nameDisplay      String?       // [P] kuratovaný názov pre web
  category         Category?     @relation(fields: [categoryId], references: [id])
  categoryId       String?
  brand            String?
  systemCode       String?       // Tork N4/H2/S4/T3...
  unit             String        @default("ks") // [C] SKz.MJ
  mj2Koef          Decimal?      @db.Decimal(12, 3)
  vatRate          Decimal       @db.Decimal(5, 2) @default(23)
  basePrice        Decimal?      @db.Decimal(12, 4) // [C] ProdejKc
  costPrice        Decimal?      @db.Decimal(12, 4) // [C] VNakup — NIKDY zákazníkovi
  stockCache       Decimal?      @db.Decimal(12, 3) // [C] StavZ
  reserved         Decimal?      @db.Decimal(12, 3)
  stockSyncedAt    DateTime?
  isStocked        Boolean       @default(false) // drží sa skladom vs back-order
  leadDays         Int           @default(5)
  productKind      ProductKind   @default(CONSUMABLE)
  isSubsidized     Boolean       @default(false) // dotovaný/prenajatý dávkovač → cena na vyžiadanie
  shelfStatus      ShelfStatus   @default(CATALOG)
  featuredReason   String?
  curationOverride CurationOverride @default(NONE)
  contentStatus    ContentStatus @default(STUB)
  prices           ProductPrice[]
  media            ProductMedia[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  syncedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([categoryId])
  @@index([shelfStatus])
  @@index([productKind])
}

model ProductPrice {
  id            String      @id @default(cuid())
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  priceTierCode String
  unitPriceNet  Decimal     @db.Decimal(12, 4)
  source        PriceSource @default(POHODA)
  syncedAt      DateTime?

  @@unique([productId, priceTierCode])
  @@index([priceTierCode])
}

model ProductMedia {
  id          String  @id @default(cuid())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  storagePath String  // Supabase Storage
  alt         String?
  isPrimary   Boolean @default(false)
  sortOrder   Int     @default(0)

  @@index([productId])
}

// ---------- Košík ---------- [P]

model Cart {
  id                 String     @id @default(cuid())
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  createdBy          User       @relation("CartCreatedBy", fields: [createdById], references: [id])
  createdById        String
  deliveryLocationId String?
  items              CartItem[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([companyId])
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  qty       Decimal @db.Decimal(12, 3)

  @@unique([cartId, productId])
}

// ---------- Objednávky ---------- [H]

model Order {
  id                   String           @id @default(cuid())
  number               String           @unique // "WEB-2026-00042"
  company              Company          @relation(fields: [companyId], references: [id])
  companyId            String
  createdBy            User             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById          String
  deliveryLocation     DeliveryLocation? @relation(fields: [deliveryLocationId], references: [id])
  deliveryLocationId   String?
  status               OrderStatus      @default(PRIJATA)
  hasBackorder         Boolean          @default(false)
  priceTierCode        String
  note                 String?
  subtotal             Decimal          @db.Decimal(12, 4) @default(0)
  vat                  Decimal          @db.Decimal(12, 4) @default(0)
  total                Decimal          @db.Decimal(12, 4) @default(0)
  requestedDeliveryDate DateTime?
  promisedDeliveryDate  DateTime?
  confirmedAt          DateTime?
  // technická os synca s Pohodou (zákazník nevidí)
  pohodaSync           PohodaSyncStatus @default(LOKALNA)
  pohodaObjNumber      String?
  pohodaFaNumber       String?
  pohodaPushedAt       DateTime?
  items                OrderItem[]
  events               OrderStatusEvent[]
  invoice              Invoice?
  syncJobs             PohodaSyncJob[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([pohodaSync])
}

model OrderItem {
  id                String      @id @default(cuid())
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  product           Product     @relation(fields: [productId], references: [id])
  productId         String
  skuSnapshot       String
  nameSnapshot      String
  unitPriceSnapshot Decimal     @db.Decimal(12, 4)
  costSnapshot      Decimal?    @db.Decimal(12, 4)
  qty               Decimal     @db.Decimal(12, 3)
  lineTotal         Decimal     @db.Decimal(12, 4)
  fulfillment       Fulfillment @default(SKLADOM)
  expectedAt        DateTime?

  @@index([orderId])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  status      OrderStatus
  changedBy   User?        @relation("StatusChangedBy", fields: [changedById], references: [id])
  changedById String?
  source      StatusSource @default(PORTAL)
  note        String?
  occurredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

// ---------- Faktúry ---------- [C] cache z Pohody + PDF

model Invoice {
  id             String        @id @default(cuid())
  pohodaNumber   String        @unique
  company        Company       @relation(fields: [companyId], references: [id])
  companyId      String
  order          Order?        @relation(fields: [orderId], references: [id])
  orderId        String?       @unique
  status         InvoiceStatus @default(PENDING)
  issuedAt       DateTime
  dueAt          DateTime
  paidAt         DateTime?
  subtotal       Decimal       @db.Decimal(12, 4)
  vat            Decimal       @db.Decimal(12, 4)
  total          Decimal       @db.Decimal(12, 4)
  pdfStoragePath String?
  sourceDbYear   Int?
  syncedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([status])
}

// ---------- Dávkovače / installed base ---------- [P]

model DispenserModel {
  id           String             @id @default(cuid())
  dispenserSku String             @unique
  name         String
  imageUrl     String?
  systemCode   String?
  refills      DispenserRefill[]
  placements   CompanyDispenser[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model DispenserRefill {
  id               String         @id @default(cuid())
  dispenserModel   DispenserModel @relation(fields: [dispenserModelId], references: [id], onDelete: Cascade)
  dispenserModelId String
  refillSku        String
  rank             Int            @default(0) // 0 = primárna náplň
  source           RefillSource   @default(DERIVED)
  confidence       Decimal?       @db.Decimal(5, 4)

  @@unique([dispenserModelId, refillSku])
}

model CompanyDispenser {
  id                 String           @id @default(cuid())
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  dispenserModel     DispenserModel   @relation(fields: [dispenserModelId], references: [id])
  dispenserModelId   String
  deliveryLocation   DeliveryLocation? @relation(fields: [deliveryLocationId], references: [id])
  deliveryLocationId String?
  location           String?
  qty                Int              @default(1)
  arrangement        Arrangement      @default(RENTAL)
  placedAt           DateTime?
  avgRefillDays      Int?
  lastRefillAt       DateTime?
  nextRefillDue      DateTime?
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([companyId])
}

// ---------- Sync infraštruktúra ---------- [P]

model SyncCursor {
  id        String   @id @default("singleton")
  skz       DateTime?
  ad        DateTime?
  prices    DateTime?
  fa        DateTime?
  updatedAt DateTime @updatedAt
}

model SyncState {
  id              String   @id @default("singleton")
  lastInboundAt   DateTime?
  lastStockSyncAt DateTime?
  lastHeartbeatAt DateTime?
  agentVersion    String?
  updatedAt       DateTime @updatedAt
}

model PohodaSyncJob {
  id        String        @id @default(cuid())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  kind      SyncJobKind
  payload   Json?
  status    SyncJobStatus @default(QUEUED)
  attempts  Int           @default(0)
  claimedBy String?
  claimedAt DateTime?
  lastError String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([orderId])
}

model DocDedup {
  id        String   @id @default(cuid())
  docType   String
  docNumber String
  docDate   DateTime
  createdAt DateTime @default(now())

  @@unique([docType, docNumber, docDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
