# ── Supabase Postgres (Project Settings → Database → Connection string) ──
# App používa pooler (port 6543, pgbouncer), migrácie direct (port 5432).
# Pozn.: región v hostname (aws-1-eu-central-1) musí sedieť s tvojím projektom.
DATABASE_URL="postgresql://postgres.<ref>:<heslo>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<heslo>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Supabase API (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── E-maily (Resend) ──
RESEND_API_KEY="<resend-key>"
# Odosielateľ z OVERENEJ domény v Resend, napr. "Moonid <web@moonid.sk>".
# Bez tohto kontaktný formulár v produkcii e-mail NEPOŠLE (len zaloguje).
RESEND_FROM="Moonid <web@moonid.sk>"

# ── Verejná URL nasadenia (pre invite/reset odkazy a kanonické URL) ──
# Musí byť pridaná aj v Supabase → Authentication → URL Configuration (Redirect URLs).
NEXT_PUBLIC_SITE_URL="https://www.moonid.sk"
