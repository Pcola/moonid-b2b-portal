# ── Supabase Postgres (Project Settings → Database → Connection string) ──
# App používa pooler (port 6543, pgbouncer), migrácie direct (port 5432).
# Pozn.: región v hostname (aws-1-eu-central-1) musí sedieť s tvojím projektom.
DATABASE_URL="postgresql://postgres.<ref>:<heslo>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<heslo>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Supabase API (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── E-maily (Resend) ──
RESEND_API_KEY="<resend-key>"
# Odosielateľ z OVERENEJ domény v Resend, napr. "Moonid <web@moonid.sk>".
# Bez tohto kontaktný formulár v produkcii e-mail NEPOŠLE (len zaloguje).
RESEND_FROM="Moonid <web@moonid.sk>"
# Kam chodia interne notifikacie (dopyty, nove objednavky). Default: moonid@moonid.sk
STAFF_NOTIFY_EMAIL="moonid@moonid.sk"

# ── Verejná URL nasadenia (pre invite/reset odkazy a kanonické URL) ──
# JEDINÝ prepínač domény pre celý web (canonical, OG, sitemap, robots, odkazy v e-mailoch) —
# resolver je lib/site-url.ts. Ak nie je nastavená, použije sa produkčná URL Vercel projektu
# (na Verceli) alebo http://localhost:3000 (lokálne). Nastav ju až na doménu, ktorá tento
# portál REÁLNE servuje — inak canonicaly mieria na cudzí web (viď go-live audit, B1/B2).
# Musí byť pridaná aj v Supabase → Authentication → URL Configuration (Site + Redirect URLs).
NEXT_PUBLIC_SITE_URL=""

# Aspoň 32 náhodných bajtov (napr. `openssl rand -base64 48`). Pseudonymizuje IP/e-mail
# v DB rate-limit kľúčoch. V produkcii je povinný; rotácia iba vynuluje aktuálne okná.
RATE_LIMIT_HMAC_SECRET=""

# Readiness SLA pre Pohoda integráciu. /api/health vráti 503 pri prekročení a staff uvidí alert.
SYNC_HEARTBEAT_MAX_HOURS="12"
STOCK_SYNC_MAX_HOURS="48"
SYNC_JOB_MAX_HOURS="2"

# ── Monitoring (Sentry) ──
# BEZ tejto premennej je Sentry úplne inertný (enabled:false) → chyby z fail-open ciest
# (audit/email/rate-limit) NIKDE nevidíš. V produkcii NUTNÉ nastaviť. (Sentry → Project → DSN)
NEXT_PUBLIC_SENTRY_DSN="https://<key>@<org>.ingest.de.sentry.io/<project>"
