# ── Supabase Postgres (Project Settings → Database → Connection string) ──
# App používa pooler (port 6543, pgbouncer), migrácie direct (port 5432).
DATABASE_URL="postgresql://postgres.<ref>:<heslo>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<heslo>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Supabase API (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── E-maily ──
RESEND_API_KEY="<resend-key>"

# ── Pohoda sync agent (outbound, bearer token) ──
SYNC_AGENT_TOKEN="<dlhy-nahodny-token>"
